/* This is a replacement for the sound section of the RCA CDP1864 video chip.
   It stands alone from any of the video generation circuity, implementing
   its own control logic for N2 and MRD for controlling latch writes. */

name      SOUND;
partno    SOUND;
revision  A;
date      05/03/25;
designer  David Madole;
company   github.com/dmadole;
assembly  Mini/1864;
location  U1;
device    V750C;


/* INPUTS */

pin  1     =  TPB ;
pin [2..9] = [BUS0..7] ;
pin  10    =  N2 ;
pin  11    = !MRD ;
pin  13    =  ENABLE ;
pin  14    =  N0 ;


/* OUTPUTS */

pin 22 = I61N ;
pin 23 = OUTPUT ;


FALSE = 'b'0 ;
TRUE  = 'b'1 ;


/* The buried nodes are chosen so that there are enough product terms for
   each register. In particular, TIMER2 needs nine terms, so it has to be
   able to use combined terms. So, we put that on pin 36, which has 10
   combined terms (which means we can't use buried pin 26). TIMER3 needs
   eight and each further one needs one less, so we line those up accordingly
   as well. The LATCH pins have few terms so they just use what is left. */

/* BURIED NODES */

pin [35,36,39,40,41,42,37,38,25] = [TIMER1..9] ;
pin [27,28,29,30,31,32,33,34]    = [LATCH2..9] ;


/* We fell short of pins on the VIDEO PLD so to save a pin, we decode the
   background color rotate signal, I61N (output to port 1) here in the sound
   chip since we already have everything needed except N0. This way we can
   replace MRD and N0 on the VIDEO PLD with one signal. Because we are using
   all the nodes as registers, we need to dual-purpose a pin for output, and
   so his signal must be active-low (but we can't invert at the pin
   definition). See TIMER0 below for more information. */
   
I61N = !N0 # !MRD ;


/* The I61N output pin has it's Q0 register used as a latch to implement the
   TIMER0 signal. The input to the register is tied to the output pin, which
   can work in this case since TIMER0 toggles on every TPB clock, so all we
   need for that is for it's T input to be high at the rising edge of TPB.
   Since I61N is normally high and goes low only concurrently with TPB, this
   is perfect for our use since T will always be high at the start of TPB.
   
   This makes some of the naming awkward but we can help a little bit by
   assigning a variable to the register's output, so that it at least looks
   superficially orthagonal with the other timer bits. The register clock and
   preset settings need to be addressed with the output name, though. */

I61N.ckmux = TPB ;
I61N.sp = FALSE ;
TIMER0 = I61N.tfb ;


/* LATCH holds the current divisor value, it is written to from BUS when N2
   is high during a memory read cycle, which is an output to port 4-7.

   The LATCH bits are numbered to correspond to the TIMER bits to make the
   counter logic tidy, but the low two bits don't exist physically, as they
   are the prescaler bits that are always loaded to 'b'11. */

LOAD = N2 & MRD ;

[LATCH0..1] = 'b'11 ;

[LATCH2..9].ckmux = TPB ;
[LATCH2..9].sp = FALSE ;
[LATCH2..9].d = LOAD & [BUS0..7] # !LOAD & [LATCH2..9] ;


/* TIMER is the frequency divider counter, which is ten bits because is has
   a divide-by-four prescaler. Treating it as one counter rather than two
   makes the logic a little easier. We need to load the value of LATCH into
   TIMER at every TPB when TIMER is zero. The two lowest prescaler bits are
   always reset to 11, but the lowest one is really I16N remember.

   When TIMER is not being loaded, it needs to count down. Since we are using
   T flip-flops, this is easy, we just need to set T whenever all the lower
   bits of TIMER are zero, excepting bit 0 of course, which is always one. */

RESET = ![TIMER0..9]:& ;

[TIMER1..9].ckmux = TPB ;
[TIMER1..9].sp = FALSE ;

$REPEAT i = [1..9]
  TIMER{i}.t = RESET & LATCH{i} # !RESET & ![TIMER{i-1}..0]:& ;
$REPEND


/* OUTPUT is the divided-by-two output of the frequency divider counter, so
   we just toggle it every time the frequency divider is zero. Note that when
   LATCH is loaded with zero, this will happen on every TPB, when latch is
   one, it will happen every other TPB, and so on. The enable pin, when not
   asserted, holds the output in reset so that it stays low. */
   
OUTPUT.ckmux = TPB ;
OUTPUT.t = RESET ;
OUTPUT.ar = !ENABLE ;
OUTPUT.sp = FALSE ;


/* The end */
